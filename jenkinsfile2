// This jenkinsfile is used to automate the installation of kops on an EC2 instance using Ansible.
pipeline {
    agent any
    
    tools {
        maven 'maven'
    }
    
    environment {
        ANSIBLE_INVENTORY = '/home/ec2-user/jenkins/workspace/k8s-kops/hosts.ini'
        ANSIBLE_PLAYBOOK = '/home/ec2-user/jenkins/workspace/k8s-kops/03-install-kops.yml'
    }

    stages {
        stage('Checkout Code') {
            steps {
                git branch: 'project-2',
                credentialsId: 'github',
                url: 'https://github.com/TWhilst/proj-mdp-152-155.git'
            }
        }
        
        stage('Install kops') {
            steps {
                ansiblePlaybook(
                    playbook: ANSIBLE_PLAYBOOK,
                    inventory: ANSIBLE_INVENTORY,
                )
            }
        }
    }
}
